@model NumuneKabul.Application.DTOs.SettingsDto
@{
    ViewData["Title"] = "Sistem Ayarlarý";
}

<div class="page-header mb-4">
    <div>
        <h2 class="h3 mb-1 text-dark" style="font-weight: 700;">Sistem Ayarlarý</h2>
        <p class="text-muted mb-0">Uygulamanýn genel yapýlandýrmasýný ve entegrasyon parametrelerini yönetin.</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-0 shadow-sm rounded-4" style="max-width: 800px;">
    <div class="card-body p-4">
        <form asp-action="Index" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            
            <h5 class="mb-4 text-primary"><i class="bi bi-cloud-arrow-up me-2"></i> Entegrasyon Ayarlarý</h5>
            
            <div class="mb-4">
                <label asp-for="MockRestUrl" class="form-label fw-medium text-dark">LIS / HBYS Servis URL (MockRestUrl)</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-link-45deg text-muted"></i></span>
                    <input asp-for="MockRestUrl" class="form-control border-start-0 ps-0" placeholder="https://..." />
                </div>
                <div class="form-text mt-2">Dýþ sistem entegrasyonunun yapýlacaðý hedef uç nokta (endpoint).</div>
            </div>

            <hr class="my-4 border-light" />
            <h5 class="mb-4 text-primary"><i class="bi bi-hdd-network me-2"></i> Depolama Ayarlarý</h5>

            <div class="row mb-4">
                <div class="col-md-6 mb-3 mb-md-0">
                    <label asp-for="PdfPath" class="form-label fw-medium text-dark">PDF Kayýt Dizini</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-folder text-muted"></i></span>
                        <input asp-for="PdfPath" class="form-control border-start-0 ps-0" />
                    </div>
                </div>
                
                <div class="col-md-6">
                    <label asp-for="ImagePath" class="form-label fw-medium text-dark">Görsel (Kesit) Kayýt Dizini</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-images text-muted"></i></span>
                        <input asp-for="ImagePath" class="form-control border-start-0 ps-0" />
                    </div>
                </div>
            </div>

            <hr class="my-4 border-light" />

            <div class="d-flex justify-content-end gap-2">
                <button type="submit" class="btn btn-primary px-4">
                    <i class="bi bi-check-lg me-1"></i> Ayarlarý Kaydet
                </button>
            </div>
        </form>
    </div>
</div>

