@model NumuneKabul.Application.DTOs.UpdateInstitutionDto
@{
    ViewData["Title"] = "Kurum Düzenle";
}

<div class="page-header mb-4">
    <div>
        <h2 class="h3 mb-1 text-dark" style="font-weight: 700;">Kurum Düzenle</h2>
        <p class="text-muted mb-0">Mevcut kurum bilgisini güncelleyin.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-2"></i> Geri Dön
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4" style="max-width: 600px;">
    <div class="card-body p-4">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            
            <div class="mb-4">
                <label asp-for="Name" class="form-label fw-medium text-dark">Kurum Adý <span class="text-danger">*</span></label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-building text-muted"></i></span>
                    <input asp-for="Name" class="form-control border-start-0 ps-0" />
                </div>
                <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-light px-4">Ýptal</a>
                <button type="submit" class="btn btn-primary px-4">
                    <i class="bi bi-check-lg me-1"></i> Güncelle
                </button>
            </div>
        </form>
    </div>
</div>

