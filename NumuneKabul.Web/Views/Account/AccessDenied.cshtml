@{
    ViewData["Title"] = "Eriþim Reddedildi";
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Dijital Numune Merkezi</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    
    <style>
        :root {
            --bg-light: #f8fafc;
            --text-main: #1e293b;
            --font-heading: 'Outfit', sans-serif;
            --font-body: 'Inter', sans-serif;
        }
        body {
            font-family: var(--font-body);
            background-color: var(--bg-light);
            color: var(--text-main);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .error-card {
            background: white;
            border-radius: 1.5rem;
            padding: 3rem;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05);
            max-width: 500px;
            text-align: center;
        }
        .error-icon {
            font-size: 4rem;
            color: #ef4444; /* red-500 */
            margin-bottom: 1rem;
        }
        h1 {
            font-family: var(--font-heading);
            font-weight: 700;
            margin-bottom: 1rem;
        }
        .btn-home {
            background-color: #0ea5e9;
            border: none;
            color: white;
            padding: 0.75rem 2rem;
            border-radius: 0.75rem;
            font-weight: 500;
            margin-top: 1.5rem;
            display: inline-block;
            text-decoration: none;
            transition: all 0.2s;
        }
        .btn-home:hover {
            background-color: #0284c7;
            color: white;
            transform: translateY(-2px);
        }
    </style>
</head>
<body>
    <div class="error-card">
        <i class="bi bi-shield-lock-fill error-icon"></i>
        <h1>Yetkisiz Eriþim</h1>
        <p class="text-muted">Bu sayfayý görüntülemek için gerekli rol veya izinlere sahip deðilsiniz. Lütfen sistem yöneticinizle iletiþime geçin.</p>
        <a href="/" class="btn-home">
            <i class="bi bi-house-door me-2"></i> Ana Sayfaya Dön
        </a>
    </div>
</body>
</html>
