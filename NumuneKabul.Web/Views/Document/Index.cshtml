@model NumuneKabul.Web.Models.PaginatedResultViewModel<NumuneKabul.Web.Models.PdfDocumentViewModel>
@{
    ViewData["Title"] = "Belgelerim";
}

<div class="container py-4">
    <div class="page-header d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 fw-bold text-primary">Numune Belgeleri</h2>
            <p class="text-muted mb-0">Sisteme yüklenen tüm dokümanları buradan yönetebilirsiniz.</p>
        </div>
        <a asp-action="Upload" class="btn btn-primary shadow-sm rounded-pill px-4">
            <i class="bi bi-cloud-arrow-up-fill me-2"></i> Yeni PDF Yükle
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 rounded-4 overflow-hidden mb-4" style="background: var(--card-bg);">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-sm align-middle mb-0" style="font-size: 0.9rem;">
                    <thead>
                        <tr>
                            <th class="ps-4 border-0">Dosya Adı</th>
                            <th class="border-0">Kurum</th>
                            <th class="border-0">Şablon</th>
                            <th class="border-0">Yüklenme Tarihi</th>
                            <th class="border-0">Durum</th>
                            <th class="text-end pe-3 border-0">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody class="border-top-0">
                        @if (Model == null || !Model.Items.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5">
                                    <div class="text-muted d-flex flex-column align-items-center justify-content-center">
                                        <i class="bi bi-folder2-open display-4 mb-3 opacity-50 text-primary"></i>
                                        <h5 class="fw-bold">Henüz Belge Yok</h5>
                                        <p class="mb-3 small">Sisteme henüz hiç belge yüklenmemiş.</p>
                                        <a asp-action="Upload" class="btn btn-primary rounded-pill px-4 fw-medium shadow-sm">
                                            <i class="bi bi-cloud-upload me-2"></i>İlk Belgeyi Yükle
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model.Items)
                            {
                                <tr style="cursor: pointer;" onclick="window.location.href='@Url.Action("Viewer", "Document", new { id = item.Id })';">
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center">
                                            <div class="bg-danger bg-opacity-10 text-danger rounded-3 p-2 me-3 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                                                <i class="bi bi-file-earmark-pdf-fill fs-5"></i>
                                            </div>
                                            <span class="fw-bold text-dark">@item.FileName</span>
                                        </div>
                                    </td>
                                    <td><span class="badge bg-secondary rounded-pill fw-medium px-3">@item.InstitutionName</span></td>
                                    <td><span class="text-muted small fw-medium">@(item.TemplateName ?? "Otomatik")</span></td>
                                    <td>
                                        <div class="d-flex align-items-center text-muted small fw-medium">
                                            <i class="bi bi-clock me-1"></i>
                                            <span class="local-time" data-utc="@item.UploadDate.ToString("o")">
                                                @item.UploadDate.ToString("dd.MM.yyyy HH:mm")
                                            </span>
                                        </div>
                                    </td>
                                    <td>
                                        @{
                                            var badgeColor = item.Status == "Uploaded" ? "bg-info" : (item.Status == "OcrCompleted" ? "bg-success" : "bg-warning");
                                            var icon = item.Status == "Uploaded" ? "bi-cloud-check" : (item.Status == "OcrCompleted" ? "bi-check-all" : "bi-hourglass-split");
                                        }
                                        <span class="badge @badgeColor rounded-pill px-2 py-1"><i class="bi @icon me-1"></i>@item.Status</span>
                                    </td>
                                    <td class="pe-3" onclick="event.stopPropagation();">
                                        <div class="d-flex justify-content-end align-items-center gap-1">
                                            @if (item.Status == "OcrCompleted")
                                            {
                                                <a asp-action="OcrResult" asp-route-id="@item.Id" class="btn btn-sm btn-outline-success rounded-pill px-2 fw-medium">
                                                    <i class="bi bi-file-text"></i> OCR Sonucu
                                                </a>
                                            }
                                            <a asp-action="Viewer" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill px-2 fw-medium">
                                                <i class="bi bi-eye"></i> Görüntüle
                                            </a>
                                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="m-0 p-0" onsubmit="return confirm('Bu belgeyi silmek istediğinize emin misiniz?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2 fw-medium" title="Sil">
                                                    <i class="bi bi-trash3"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Sayfalama (Pagination) Kontrolleri -->
    @if (Model != null && Model.TotalPages > 1)
    {
        <nav aria-label="PDF Sayfalama">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)" tabindex="-1" aria-disabled="@(!Model.HasPrevious)">Önceki</a>
                </li>
                
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                    </li>
                }
                
                <li class="page-item @(Model.HasNext ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)">Sonraki</a>
                </li>
            </ul>
        </nav>
    }
</div>

<style>
    /* Modern Micro-animations */
    .table-hover tbody tr {
        transition: all 0.2s ease-in-out;
    }
    .table-hover tbody tr:hover {
        background-color: #f8f9fa;
        transform: scale(1.002);
    }
</style>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // "local-time" sınıfına sahip tüm tarihleri bul
            const timeElements = document.querySelectorAll('.local-time');
            
            timeElements.forEach(el => {
                // Backend'den gelen UTC tarihini al (ISO 8601 formatında)
                // Sonuna 'Z' ekleyerek tarayıcıya bunun kesinlikle UTC olduğunu belirtiyoruz (API 'o' formatında Z dönmüyorsa diye garanti altına almak için)
                let utcString = el.getAttribute('data-utc');
                if (!utcString.endsWith('Z')) {
                    utcString += 'Z';
                }

                const utcDate = new Date(utcString);
                
                // Eğer geçerli bir tarihse, kullanıcının bilgisayarının saatine göre formatla
                if (!isNaN(utcDate)) {
                    el.textContent = utcDate.toLocaleString(undefined, { 
                        year: 'numeric', month: '2-digit', day: '2-digit', 
                        hour: '2-digit', minute:'2-digit' 
                    });
                }
            });
        });
    </script>
}
