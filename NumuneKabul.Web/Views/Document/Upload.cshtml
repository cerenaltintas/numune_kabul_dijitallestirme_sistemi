@model NumuneKabul.Web.Models.PdfUploadViewModel
@{
    ViewData["Title"] = "PDF Yükle";
}

<div class="page-header">
    <div>
        <h2 class="mb-1"><i class="bi bi-cloud-upload text-primary me-2"></i> Yeni Doküman Yükle</h2>
        <p class="text-muted mb-0">Sisteme yeni bir başvuru formu ekleyin ve OCR ile okutun.</p>
    </div>
</div>

<div class="container-fluid p-0">
    <div class="row">
        <div class="col-md-11 col-lg-9 col-xl-8">
            
            <div class="card border-0 rounded-4 overflow-hidden shadow-sm">
                <div class="card-body p-4">
                    <form asp-action="Upload" enctype="multipart/form-data" method="post">
                        
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-3 border-0"></div>
                        
                        <!-- Removed Kurum ve Şablon Seçimi -->

                        <!-- Premium Drag & Drop Area -->
                        <div class="mb-4">
                            <label asp-for="File" class="form-label fw-bold text-primary"></label>
                            <div class="rounded-4 p-4 text-center position-relative file-drop-zone d-flex flex-column align-items-center justify-content-center" 
                                 style="min-height: 180px;">
                                <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                                    <i class="bi bi-cloud-arrow-up text-primary fs-2"></i>
                                </div>
                                <h5 class="fw-bold text-dark mb-1">Belgenizi Buraya Bırakın</h5>
                                <p class="text-muted fw-medium mb-0 small">veya cihazınızdan seçmek için tıklayın</p>
                                <span class="badge bg-secondary mt-2 rounded-pill">Maksimum 50 MB (PDF)</span>
                                <input asp-for="File" type="file" class="form-control position-absolute top-0 start-0 w-100 h-100 opacity-0" style="cursor: pointer;" accept=".pdf" />
                            </div>
                            <span asp-validation-for="File" class="text-danger small mt-1 d-block fw-medium text-center"></span>
                        </div>
                        
                        <div class="d-flex justify-content-between align-items-center pt-2">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 fw-medium">Vazgeç</a>
                            <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold shadow-sm d-flex align-items-center">
                                <i class="bi bi-check2-circle me-2 fs-5"></i> Yükle ve Analiz Et
                            </button>
                        </div>
                    </form>
                </div>
            </div>
            
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        // Dosya seçildiğinde adını göstermek için ufak animasyon
        const fileInput = document.querySelector('input[type="file"]');
        const dropZone = document.querySelector('.file-drop-zone h5');
        
        fileInput.addEventListener('change', function(e) {
            if(this.files && this.files.length > 0) {
                const file = this.files[0];
                const maxSize = 52428800; // 50 MB
                
                if(file.size > maxSize) {
                    alert("Seçtiğiniz dosya boyutu 50 MB sınırını aşıyor (" + (file.size / (1024*1024)).toFixed(2) + " MB). Lütfen daha küçük bir PDF seçin.");
                    this.value = ''; // Input'u temizle
                    dropZone.innerHTML = '<span class="text-danger fw-bold"><i class="bi bi-x-circle me-2"></i>Dosya çok büyük (Maks 50 MB)</span>';
                    return;
                }
                
                dropZone.innerHTML = '<span class="text-success" id="fileNameSpan"><i class="bi bi-check-circle me-2"></i></span>';
                document.getElementById('fileNameSpan').appendChild(document.createTextNode(file.name));
            }
        });

        // Removed Institution/Template selection logic
    </script>
}
