<!-- Defensive Programming: Veri ifşasını ve XSS ataklarını önlemek için JSON verisi güvenli bir script bloğuna alındı -->
<script id="extractedFieldsData" type="application/json">
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ExtractedFields ?? new List<NumuneKabul.Web.Models.ExtractedFieldViewModel>()))
</script>

<script>
    // ---------------------------------------------------------
    // Clean Code & SRP: Tüm görünüm mantığı bir sınıf içerisine kapsüllendi (Encapsulation)
    // ---------------------------------------------------------
    class DocumentViewerApp {
        constructor(pdfId, initialPage) {
            this.pdfId = pdfId;
            this.currentPage = initialPage;
            this.zoomLevel = 1.0;
            this.rotation = 0;
            this.extractedFields = this.loadFieldsData();
            
            this.initElements();
            this.bindEvents();
            this.initAutoResize();
            this.updateThumbnailSelection();
        }

        loadFieldsData() {
            try {
                const dataElement = document.getElementById('extractedFieldsData');
                return dataElement ? JSON.parse(dataElement.textContent) : [];
            } catch (error) {
                console.error("OCR verileri yüklenirken hata oluştu.", error);
                return [];
            }
        }

        initElements() {
            this.leftPanel = document.getElementById('leftPanel');
            this.rightPanel = document.getElementById('rightPanel');
            this.resizer = document.getElementById('dragResizer');
            this.pdfContainer = document.getElementById('pdfContainer');
            this.ocrContainer = document.getElementById('ocrContainer');
            this.ocrScrollArea = document.getElementById('ocrScrollArea');
            this.zoomLevelSpan = document.getElementById('zoomLevelSpan');
            this.paginationControls = document.getElementById('paginationControls');
            this.pageImage = document.getElementById('pageImage');
            this.highlightsLayer = document.getElementById('highlightsLayer');
            this.currentPageSpan = document.getElementById('currentPageSpan');
            this.isResizing = false;
            
            this.createInlineEditorElement();

            window.addEventListener('resize', this.handleResize);
        }

        bindEvents() {
            // Resizer (Sürükleme) Olayları
            if (this.resizer) {
                this.resizer.addEventListener('mousedown', (e) => this.startResizing(e));
                document.addEventListener('mousemove', (e) => this.handleResizing(e));
                document.addEventListener('mouseup', () => this.stopResizing());
                
                window.addEventListener('resize', () => {
                    if (window.innerWidth < 992) {
                        this.leftPanel.style.width = '100%';
                        this.rightPanel.style.width = '100%';
                    } else if (this.leftPanel.style.width === '100%') {
                        this.leftPanel.style.width = '65%';
                        this.rightPanel.style.width = '35%';
                    }
                });
            }

            // Sayfa Yeniden Boyutlandırma (Debounced) - Performans için
            let resizeTimer;
            window.addEventListener('resize', () => {
                clearTimeout(resizeTimer);
                resizeTimer = setTimeout(() => {
                    if (this.ocrContainer && !this.ocrContainer.classList.contains('d-none')) {
                        this.drawHighlights();
                    }
                }, 100); // 100ms debounce
            });

            // Resim yüklendiğinde işaretleri çiz
            if (this.pageImage) {
                this.pageImage.addEventListener('onload', () => this.drawHighlights());
            }

            // Sekme değişimlerinde textarea boyutlarını güncelle
            const rightPanelTabs = document.getElementById('rightPanelTabs');
            if (rightPanelTabs) {
                rightPanelTabs.addEventListener('shown.bs.tab', (event) => {
                    if (event.target.id === 'fields-tab') {
                        this.initAutoResize();
                    }
                });
            } // ADDED MISSING BRACE
            
            // Form submission interceptor (AJAX)
            const ajaxForms = document.querySelectorAll('.ajax-update-form');
            ajaxForms.forEach(form => {
                form.addEventListener('submit', (e) => this.handleAjaxSubmit(e, form));
            });
        }

        async handleAjaxSubmit(e, form) {
            e.preventDefault();
            
            const submitBtn = form.querySelector('button[type="submit"]');
            const originalBtnHtml = submitBtn.innerHTML;
            const textInput = form.querySelector('textarea[name="correctedValue"]');
            const fieldId = parseInt(form.querySelector('input[name="fieldId"]').value);
            
            try {
                submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>';
                submitBtn.disabled = true;

                const formData = new FormData(form);
                const actionUrl = form.getAttribute('action');

                const response = await fetch(actionUrl, {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });

                if (!response.ok) throw new Error('Network response was not ok');
                const result = await response.json();

                if (result.success) {
                    // Update UI (Success visual)
                    textInput.classList.remove('border-warning', 'border-danger', 'border-2');
                    textInput.classList.add('border-success');
                    
                    const label = form.querySelector('label');
                    if (!label.innerHTML.includes('Düzeltildi')) {
                         label.innerHTML += ' <span class="badge bg-info"><i class="bi bi-pencil"></i> Düzeltildi</span>';
                    }

                    // Remove small warning/danger texts if any
                    const alerts = form.querySelectorAll('small.text-danger, small.text-warning');
                    alerts.forEach(a => a.remove());
                    
                    // Show success visual feedback
                    this.showToast('Başarılı', result.message, 'success');
                    
                    // Update the local extractedFields array so the highlight color turns green!
                    const field = this.extractedFields.find(f => (f.Id || f.id) === fieldId);
                    if (field) {
                        field.Status = 'Corrected';
                        field.Severity = 'Success';
                        field.RawValue = formData.get('correctedValue');
                        if (this.ocrContainer && !this.ocrContainer.classList.contains('d-none')) {
                            this.drawHighlights(); 
                        }
                    }
                } else {
                    this.showToast('Hata', result.message, 'danger');
                }
            } catch (error) {
                console.error('AJAX Error:', error);
                this.showToast('Hata', 'Sunucu ile iletişim kurulamadı.', 'danger');
            } finally {
                submitBtn.innerHTML = originalBtnHtml;
                submitBtn.disabled = false;
            }
        }
        
        showToast(title, message, type) {
            // Basit bir Bootstrap Toast elementi oluştur ve body'ye ekle
            const toastContainer = document.getElementById('toast-container') || this.createToastContainer();
            
            const bgClass = type === 'success' ? 'bg-success' : 'bg-danger';
            const icon = type === 'success' ? 'bi-check-circle' : 'bi-exclamation-triangle';
            
            const toastHtml = `
                <div class="toast align-items-center text-white ${bgClass} border-0" role="alert" aria-live="assertive" aria-atomic="true">
                  <div class="d-flex">
                    <div class="toast-body d-flex align-items-center">
                      <i class="bi ${icon} fs-5 me-2"></i>
                      <div>
                        <strong>${title}</strong><br/>
                        <span class="small">${message}</span>
                      </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                  </div>
                </div>
            `;
            
            const toastElement = document.createElement('div');
            toastElement.innerHTML = toastHtml.trim();
            const toastNode = toastElement.firstChild;
            toastContainer.appendChild(toastNode);
            
            const bsToast = new bootstrap.Toast(toastNode, { autohide: true, delay: 3000 });
            bsToast.show();
            
            toastNode.addEventListener('hidden.bs.toast', () => {
                toastNode.remove();
            });
        }
        
        createToastContainer() {
            const container = document.createElement('div');
            container.id = 'toast-container';
            container.className = 'toast-container position-fixed bottom-0 end-0 p-3';
            container.style.zIndex = '1055';
            document.body.appendChild(container);
            return container;
        }

        // --- Panel Boyutlandırma ---
        startResizing(e) {
            this.isResizing = true;
            this.resizer.classList.add('resizing');
            document.body.style.cursor = 'col-resize';
            document.body.style.userSelect = 'none';
            this.leftPanel.style.pointerEvents = 'none';
        }

        handleResizing(e) {
            if (!this.isResizing) return;
            const container = this.leftPanel.parentElement;
            const containerRect = container.getBoundingClientRect();
            let newLeftWidth = e.clientX - containerRect.left;
            
            const minWidth = 350;
            if (newLeftWidth < minWidth) newLeftWidth = minWidth;
            if (newLeftWidth > containerRect.width - minWidth) newLeftWidth = containerRect.width - minWidth;
            
            const newLeftPercent = (newLeftWidth / containerRect.width) * 100;
            this.leftPanel.style.width = `${newLeftPercent}%`;
            this.rightPanel.style.width = `${100 - newLeftPercent}%`;
        }

        stopResizing() {
            if (this.isResizing) {
                this.isResizing = false;
                this.resizer.classList.remove('resizing');
                document.body.style.cursor = '';
                document.body.style.userSelect = '';
                this.leftPanel.style.pointerEvents = 'auto';
            }
        }

        // --- OCR Görselleştirme ---
        toggleViewMode(mode) {
            if (mode === 'pdf') {
                this.pdfContainer.classList.remove('d-none');
                this.ocrContainer.classList.add('d-none');
            } else {
                this.pdfContainer.classList.add('d-none');
                this.ocrContainer.classList.remove('d-none');
                this.loadImageAndHighlights();
            }
        }

        zoomIn() {
            if (this.zoomLevel < 3.0) {
                this.zoomLevel += 0.25;
                this.updateZoomDisplay();
                this.drawHighlights();
            }
        }

        zoomOut() {
            if (this.zoomLevel > 0.5) {
                this.zoomLevel -= 0.25;
                this.updateZoomDisplay();
                this.drawHighlights();
            }
        }

        resetZoom() {
            this.zoomLevel = 1.0;
            this.rotation = 0;
            const wrapper = document.getElementById('imageWrapper');
            if (wrapper) wrapper.style.transform = `rotate(0deg)`;
            this.updateZoomDisplay();
            this.drawHighlights();
        }

        updateZoomDisplay() {
            if (this.zoomLevelSpan) {
                this.zoomLevelSpan.innerText = Math.round(this.zoomLevel * 100) + '%';
            }
        }

        toggleSidebar() {
            const sidebar = document.getElementById('thumbnailSidebar');
            if (sidebar) {
                if (sidebar.classList.contains('d-none')) {
                    sidebar.classList.remove('d-none');
                    sidebar.classList.add('d-flex');
                } else {
                    sidebar.classList.add('d-none');
                    sidebar.classList.remove('d-flex');
                }
            }
            
            // Allow layout transition to finish before redrawing highlights
            setTimeout(() => {
                this.drawHighlights();
            }, 150);
        }

        rotateImage() {
            this.rotation = (this.rotation + 90) % 360;
            const wrapper = document.getElementById('imageWrapper');
            if (wrapper) {
                wrapper.style.transition = 'transform 0.3s ease';
                wrapper.style.transform = `rotate(${this.rotation}deg)`;
                
                // Kutu içindeki metinlerin dönüp dönmemesi bir tercih meselesi, 
                // ancak bounding-box yapıları Wrapper içinde olduğu için image ile beraber pürüzsüzce döner!
            }
        }

        downloadPdf() {
            const link = document.createElement('a');
            link.href = `/Document/StreamPdf/${this.pdfId}`;
            link.download = `Document_${this.pdfId}.pdf`;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        printDocument() {
            // PDF yazdırma işlemi için gizli iframe kullanımı
            let iframe = document.getElementById('printFrame');
            if (!iframe) {
                iframe = document.createElement('iframe');
                iframe.id = 'printFrame';
                iframe.style.display = 'none';
                document.body.appendChild(iframe);
            }
            iframe.src = `/Document/StreamPdf/${this.pdfId}`;
            iframe.onload = () => {
                iframe.contentWindow.focus();
                iframe.contentWindow.print();
            };
        }

        changePage(delta) {
            const newPage = this.currentPage + delta;
            // Prevent going out of bounds
            const totalPages = @(Model.PageCount > 0 ? Model.PageCount : 1);
            if (newPage < 1 || newPage > totalPages) return;
            
            this.changePageTo(newPage);
        }

        changePageTo(page) {
            this.currentPage = page;
            if (this.currentPageSpan) this.currentPageSpan.innerText = this.currentPage;
            this.updateThumbnailSelection();
            this.loadImageAndHighlights();
        }

        updateThumbnailSelection() {
            // Reset borders
            const thumbs = document.querySelectorAll('.thumbnail-item img');
            thumbs.forEach(t => {
                t.style.borderColor = 'transparent';
            });
            // Highlight current
            const currentThumb = document.getElementById(`thumb_${this.currentPage}`);
            if (currentThumb) {
                currentThumb.style.borderColor = '#8ab4f8'; // PDF.js mavi sınır rengi
            }
        }

        loadImageAndHighlights() {
            if (this.pageImage) {
                this.pageImage.src = `/Document/CleanPageImage/${this.pdfId}?page=${this.currentPage}`;
            }
        }

        drawHighlights() {
            if (!this.pageImage || !this.highlightsLayer) return;
            if (!this.pageImage.src || this.pageImage.src.endsWith('#') || this.pageImage.src === window.location.href) return;

            const naturalW = this.pageImage.naturalWidth;
            const naturalH = this.pageImage.naturalHeight;

            if (naturalW === 0 || naturalH === 0) return;

            // Container padding hesapla (artık ocrScrollArea üzerinden)
            const ocrStyle = window.getComputedStyle(this.ocrScrollArea || this.ocrContainer);
            const paddingX = parseFloat(ocrStyle.paddingLeft) + parseFloat(ocrStyle.paddingRight);
            const paddingY = parseFloat(ocrStyle.paddingTop) + parseFloat(ocrStyle.paddingBottom);
            
            // Zoom = 1.0 iken (Fit) ekrana sığacak kullanılabilir alan
            const availableW = (this.ocrScrollArea || this.ocrContainer).clientWidth - paddingX;
            const availableH = (this.ocrScrollArea || this.ocrContainer).clientHeight - paddingY;

            if (availableW <= 0 || availableH <= 0) return; // Görünür değilse çık

            const imageRatio = naturalW / naturalH;
            const containerRatio = availableW / availableH;
            
            let fitW, fitH;
            if (containerRatio > imageRatio) {
                fitH = availableH;
                fitW = fitH * imageRatio;
            } else {
                fitW = availableW;
                fitH = fitW / imageRatio;
            }

            // Seçili zoom seviyesine göre boyutu ayarla
            const renderedW = fitW * this.zoomLevel;
            const renderedH = fitH * this.zoomLevel;

            this.pageImage.style.width = `${renderedW}px`;
            this.pageImage.style.height = `${renderedH}px`;

            const scaleX = renderedW / naturalW;
            const scaleY = renderedH / naturalH;

            this.highlightsLayer.innerHTML = ''; 

            const pageFields = this.extractedFields.filter(f => f.PageNo === this.currentPage || (this.currentPage === 1 && f.PageNo === 0));

            pageFields.forEach(f => {
                const fw = f.Width || f.width;
                const fh = f.Height || f.height;
                const fx = f.X || f.x;
                const fy = f.Y || f.y;

                if (!fw || fw <= 0 || !fh || fh <= 0) return;

                const box = document.createElement('div');
                box.style.position = 'absolute';
                // Kutuların içindeki metnin daha rahat okunabilmesi için hafif bir genişletme (padding) efekti veriyoruz.
                const paddingXY = 4; // 4px dışa doğru genişlet
                
                // Artık object-fit: contain ofseti yok, doğrudan scale üzerinden sol/üst belirliyoruz.
                box.style.left = `${(fx * scaleX) - paddingXY}px`;
                box.style.top = `${(fy * scaleY) - paddingXY}px`;
                box.style.width = `${(fw * scaleX) + (paddingXY * 2)}px`;
                box.style.height = `${(fh * scaleY) + (paddingXY * 2)}px`;

                let color = '#28a745'; // Default: Yeşil (Success)
                const sev = f.Severity || f.severity;
                if (sev === 'Danger') {
                    color = '#dc3545'; // Kırmızı
                } else if (sev === 'Warning') {
                    color = '#ffc107'; // Sarı
                }

                box.style.border = `2px solid ${color}`;
                box.style.backgroundColor = `${color}40`;
                box.style.pointerEvents = 'auto';
                box.style.cursor = 'pointer';
                box.title = `${f.FieldName}: ${f.RawValue || 'Boş'}`;

                // Eskiden sadece sağ paneli highlight ediyordu, şimdi inline editör açılacak
                box.onclick = (e) => {
                    e.stopPropagation(); // Parent'a tıklamayı engelle
                    this.highlightInputField(f.Id); // Sağ paneli de highlight et (visual feedback)
                    this.openInlineEditor(f, box);
                };

                this.highlightsLayer.appendChild(box);
            });
        }

        // Window resize olduğunda kutuları yeniden boyutlandır (object-fit değişebilir)
        handleResize = () => {
            if (this.resizeTimeout) clearTimeout(this.resizeTimeout);
            this.resizeTimeout = setTimeout(() => {
                this.drawHighlights();
            }, 100);
        }

        highlightInputField(fieldId) {
            const inputs = document.querySelectorAll(`input[name="fieldId"][value="${fieldId}"]`);
            if (inputs.length > 0) {
                const form = inputs[0].closest('form');
                const textInput = form.querySelector('input[name="correctedValue"]');
                if (textInput) {
                    textInput.focus();
                    
                    form.style.transition = "background-color 0.5s ease";
                    form.style.backgroundColor = "#e7f1ff";
                    setTimeout(() => { form.style.backgroundColor = ""; }, 1500);

                    const tabBtn = document.getElementById('fields-tab');
                    if (tabBtn && !tabBtn.classList.contains('active')) {
                        const tab = new bootstrap.Tab(tabBtn);
                        tab.show();
                    }
                }
            }
        }

        // --- Yüzen (Floating) Inline Editör ---
        createInlineEditorElement() {
            this.inlineEditorPanel = document.createElement('div');
            this.inlineEditorPanel.className = 'inline-editor-card';
            
            // XSS önlemi için içeriği dinamik oluşturuyoruz veya textContent atayacağız
            this.inlineEditorPanel.innerHTML = `
                <div class="inline-editor-header">
                    <span id="inlineEditorTitle">Alan Adı</span>
                    <button type="button" class="btn-close btn-sm" aria-label="Close" style="font-size: 0.6rem;"></button>
                </div>
                <div class="inline-editor-body">
                    <textarea id="inlineEditorInput" rows="2"></textarea>
                </div>
                <div class="inline-editor-actions">
                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill fw-bold" id="inlineEditorCancelBtn">
                        <i class="bi bi-x"></i> İptal
                    </button>
                    <button type="button" class="btn btn-sm btn-success rounded-pill fw-bold" id="inlineEditorSaveBtn">
                        <i class="bi bi-check2"></i> Kaydet
                    </button>
                </div>
            `;

            // Olay dinleyicileri (Event Listeners)
            const closeBtn = this.inlineEditorPanel.querySelector('.btn-close');
            const cancelBtn = this.inlineEditorPanel.querySelector('#inlineEditorCancelBtn');
            const saveBtn = this.inlineEditorPanel.querySelector('#inlineEditorSaveBtn');
            
            closeBtn.onclick = () => this.closeInlineEditor();
            cancelBtn.onclick = () => this.closeInlineEditor();
            saveBtn.onclick = () => this.saveInlineData();

            // Editör dışına tıklandığında (veya ESC) kapanması için
            document.addEventListener('mousedown', (e) => {
                if (this.inlineEditorPanel.classList.contains('show') && 
                    !this.inlineEditorPanel.contains(e.target) &&
                    !e.target.closest('#highlightsLayer > div')) { // Herhangi bir highlight kutusuna tıklanmadıysa
                    this.closeInlineEditor();
                }
            });
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape' && this.inlineEditorPanel.classList.contains('show')) {
                    this.closeInlineEditor();
                }
            });

            // Görüntüleyici panelin (ocrContainer veya parent'ı) içine ekle
            const wrapper = document.getElementById('imageWrapper');
            if (wrapper) {
                wrapper.appendChild(this.inlineEditorPanel);
            }
        }

        openInlineEditor(field, boxElement) {
            this.currentEditingFieldId = field.Id || field.id;
            
            const titleEl = this.inlineEditorPanel.querySelector('#inlineEditorTitle');
            const inputEl = this.inlineEditorPanel.querySelector('#inlineEditorInput');
            
            // XSS Önlemi: innerHTML yerine textContent / value setter kullanımı
            titleEl.textContent = field.FieldName;
            inputEl.value = field.RawValue || ''; 

            // Pozisyon hesaplama
            const boxRect = boxElement.getBoundingClientRect();
            const wrapperRect = document.getElementById('imageWrapper').getBoundingClientRect();
            
            let topPos = (boxRect.top - wrapperRect.top) + boxRect.height + 8; // Kutunun hemen altına
            let leftPos = boxRect.left - wrapperRect.left;

            // Panel sağdan taşarsa sola daya
            if (leftPos + 280 > wrapperRect.width) {
                leftPos = wrapperRect.width - 280;
            }
            // Panel alttan taşarsa kutunun üstüne koy
            if (topPos + 140 > wrapperRect.height) { // Yaklaşık panel yüksekliği 140px
                topPos = (boxRect.top - wrapperRect.top) - 148;
            }
            if (leftPos < 0) leftPos = 0;
            if (topPos < 0) topPos = 0;
            this.inlineEditorPanel.style.top = `${topPos}px`;
            this.inlineEditorPanel.style.left = `${leftPos}px`;
            
            this.inlineEditorPanel.classList.add('show');
            inputEl.focus();
        }

        closeInlineEditor() {
            this.inlineEditorPanel.classList.remove('show');
            this.currentEditingFieldId = null;
        }

        async saveInlineData() {
            if (!this.currentEditingFieldId) return;
            
            const inputEl = this.inlineEditorPanel.querySelector('#inlineEditorInput');
            const newValue = inputEl.value;
            const saveBtn = this.inlineEditorPanel.querySelector('#inlineEditorSaveBtn');
            const originalBtnHtml = saveBtn.innerHTML;

            // Arka plandaki AJAX formu bul ve kullan (UpdateField ucuna istek için)
            const form = document.querySelector(`input[name="fieldId"][value="${this.currentEditingFieldId}"]`).closest('form');
            if (!form) return;

            // Formun textarea'sını da güncelle ki backend'e yeni veri gitsin
            const formTextArea = form.querySelector('textarea[name="correctedValue"]');
            if (formTextArea) {
                formTextArea.value = newValue;
            }

            try {
                saveBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>';
                saveBtn.disabled = true;

                const formData = new FormData(form);
                const actionUrl = form.getAttribute('action');

                const response = await fetch(actionUrl, {
                    method: 'POST',
                    body: formData,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });

                if (!response.ok) throw new Error('Network response was not ok');
                const result = await response.json();

                if (result.success) {
                    this.showToast('Başarılı', result.message, 'success');
                    
                    // Sağ paneldeki formu görsel olarak güncelle
                    if (formTextArea) {
                        formTextArea.classList.remove('border-warning', 'border-danger', 'border-2');
                        formTextArea.classList.add('border-success');
                        const label = form.querySelector('label');
                        if (!label.innerHTML.includes('Düzeltildi')) {
                            label.innerHTML += ' <span class="badge bg-info"><i class="bi bi-pencil"></i> Düzeltildi</span>';
                        }
                        const alerts = form.querySelectorAll('small.text-danger, small.text-warning');
                        alerts.forEach(a => a.remove());
                    }

                    // Kutu rengini ve verisini güncelle (drawHighlights yeniden renderlar)
                    const field = this.extractedFields.find(f => (f.Id || f.id) === this.currentEditingFieldId);
                    if (field) {
                        field.Status = 'Corrected';
                        field.Severity = 'Success';
                        field.RawValue = newValue;
                        this.drawHighlights(); 
                    }
                    this.closeInlineEditor();
                } else {
                    this.showToast('Hata', result.message, 'danger');
                }
            } catch (error) {
                console.error('Inline AJAX Error:', error);
                this.showToast('Hata', 'Sunucu ile iletişim kurulamadı.', 'danger');
            } finally {
                saveBtn.innerHTML = originalBtnHtml;
                saveBtn.disabled = false;
            }
        }

        // --- Textarea Otomatik Boyutlandırma ---
        initAutoResize() {
            const textareas = document.querySelectorAll('.auto-resize-textarea');
            textareas.forEach(ta => {
                this.autoResizeTextarea(ta);
                if (!ta.dataset.resizeListenerAttached) {
                    ta.addEventListener('input', (e) => this.autoResizeTextarea(e.target));
                    ta.dataset.resizeListenerAttached = "true";
                }
            });
        }

        autoResizeTextarea(textarea) {
            if (textarea.offsetParent !== null) {
                textarea.style.height = 'auto'; 
                textarea.style.height = `${textarea.scrollHeight + 2}px`; 
            }
        }
    }

    // Genel Metotlar (HTML içinden onclick ile çağrıldığı için window objesinde bırakıldı)
    let appInstance = null;

    function toggleViewMode(mode) {
        if (appInstance) appInstance.toggleViewMode(mode);
    }

    function changePage(delta) {
        if (appInstance) appInstance.changePage(delta);
    }

    function changePageTo(page) {
        if (appInstance) appInstance.changePageTo(page);
    }

    function drawHighlights() {
        if (appInstance) appInstance.drawHighlights();
    }

    function zoomIn() {
        if (appInstance) appInstance.zoomIn();
    }

    function zoomOut() {
        if (appInstance) appInstance.zoomOut();
    }

    function resetZoom() {
        if (appInstance) appInstance.resetZoom();
    }

    function toggleSidebar() {
        if (appInstance) appInstance.toggleSidebar();
    }

    function rotateImage() {
        if (appInstance) appInstance.rotateImage();
    }

    function downloadPdf() {
        if (appInstance) appInstance.downloadPdf();
    }

    function printDocument() {
        if (appInstance) appInstance.printDocument();
    }

    function loadAuditLogs(pdfId) {
        var container = document.getElementById('auditLogContainer');
        container.innerHTML = '<div class="spinner-border text-primary spinner-border-sm" role="status"></div>';
        
        fetch(`/Document/AuditLogs/${pdfId}`)
            .then(response => response.text())
            .then(html => {
                container.innerHTML = html;
            })
            .catch(err => {
                container.innerHTML = '<p class="text-danger small">Loglar yüklenirken hata oluştu.</p>';
            });
    }

    document.addEventListener('DOMContentLoaded', () => {
        // App başlatılıyor
        const pdfId = @Model.Id;
        const initialPage = @(ViewBag.CurrentPage ?? 1);
        appInstance = new DocumentViewerApp(pdfId, initialPage);

        // Şablon yükleme mantığı
        const institutionSelect = document.getElementById('institutionSelect');
        const templateSelect = document.getElementById('templateSelect');
        
        if (institutionSelect && templateSelect) {
            institutionSelect.addEventListener('change', function() {
                const instId = this.value;
                templateSelect.innerHTML = '<option value="">Şablon Seçiniz...</option>';
                
                if (instId) {
                    templateSelect.disabled = true;
                    templateSelect.innerHTML = '<option value="">Yükleniyor...</option>';
                    
                    fetch(`/Document/GetTemplates?institutionId=${instId}`)
                        .then(response => response.json())
                        .then(data => {
                            templateSelect.innerHTML = '<option value="">Şablon Seçiniz...</option>';
                            data.forEach(item => {
                                const option = document.createElement('option');
                                option.value = item.id;
                                option.textContent = item.name;
                                templateSelect.appendChild(option);
                            });
                            templateSelect.disabled = false;
                        })
                        .catch(error => {
                            templateSelect.innerHTML = '<option value="">(Hata oluştu)</option>';
                        });
                } else {
                    templateSelect.innerHTML = '<option value="">(Önce Kurum Seçin)</option>';
                    templateSelect.disabled = true;
                }
            });
        }
    });
</script>
