{
  "DatabaseProvider": "SQLite",
  "ConnectionStrings": {
    "SQLite": "Data Source=NumuneKabul.db",
    "MSSQL": "Server=.;Database=NumuneKabulDB;Trusted_Connection=true;TrustServerCertificate=true;"
  },
  "JwtSettings": {
    // GÜVENLİK (OWASP A05): Secret bu dosyada BULUNMAMALIDIR.
    // Development: appsettings.Development.json dosyasından okunur.
    // Production: Ortam değişkeni 'ASPNETCORE_JwtSettings__Secret' üzerinden inject edilmelidir.
    "Secret": "",
    "Issuer": "NumuneKabulAPI",
    "Audience": "NumuneKabulWeb",
    "ExpirationHours": 8
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  },
  "StorageSettings": {
    "PdfPath": "uploads/pdfs",
    "ImagePath": "uploads/images"
  },
  "OcrCorrections": {
